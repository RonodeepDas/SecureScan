# ============================================================
# SecureScan Backend — Environment Variables
# ============================================================
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# STEP 1 — Install dependencies first (cryptography must be available):
#   pip install -r requirements.txt
#
# STEP 2 — Generate a 32-byte AES-256 key (hex-encoded):
#   python -c "import os, binascii; print(binascii.hexlify(os.urandom(32)).decode())"
#
# Paste the output as the value of ENCRYPTION_KEY below.
# ============================================================

# AES-256-GCM encryption key for DB fields (64 hex chars = 32 bytes)
ENCRYPTION_KEY=<paste-hex-encoded-32-byte-key-here>

# slowapi rate limit for /api/scan (requests per period)
SCAN_RATE_LIMIT=5/minute
